{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Capabilities for the settings panel window",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "updater:default"
  ]
}
